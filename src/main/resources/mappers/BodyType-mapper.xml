<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="BodyType">

 <select id="findBodyTypeInfo" resultType="map">
        SELECT *
        FROM body_type
        WHERE body_type = #{body_type}
          AND gender = #{gender}
    </select>
    
</mapper>