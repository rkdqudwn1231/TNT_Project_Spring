<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="color">

    <insert id="insert" parameterType="com.tnt.project.dto.PersonalcolorDTO">
        INSERT INTO Personalcolor (
            seq,season,tone_type,best_color,worst_color
        ) VALUES (
            Personalcolor_seq.NEXTVAL,
            #{season},
            #{tone_type},
            #{best_color},
            #{worst_color}
     
        )
    </insert>

</mapper>